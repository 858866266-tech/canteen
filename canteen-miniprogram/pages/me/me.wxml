<!-- 个人中心页面 -->
<view class="container">
  <view class="user-card">
    <view class="user-avatar">{{userInfo.avatar || '👤'}}</view>
    <view class="user-name">{{userInfo.name || '未登录'}}</view>
    <view class="user-role">{{userInfo.roleText || '请点击登录'}}</view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToPage" data-page="backup">
      <text class="menu-icon">💾</text>
      <text class="menu-text">数据备份</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="settings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">系统设置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="help">
      <text class="menu-icon">❓</text>
      <text class="menu-text">使用帮助</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToPage" data-page="about">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于系统</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <button class="btn btn-logout" bindtap="logout" wx:if="{{isLoggedIn}}">
    退出登录
  </button>
  <button class="btn btn-primary" bindtap="login" wx:else>
    登录/注册
  </button>
</view>
